# ─────────────────────────────────────────────────────────────
# Reohob website — environment variables
# Copy to .env.local for local work; set the same keys in Vercel
# (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used for canonical URLs,
# the sitemap, Open Graph and the Paystack callback.
NEXT_PUBLIC_SITE_URL=https://reohobenergy.com

# Show "To confirm" / "Sample" flags on placeholder content.
# Leave "true" until every placeholder in src/config/site.ts is confirmed.
NEXT_PUBLIC_SHOW_PLACEHOLDER_FLAGS=true

# ── Email (contact, partnership and training forms) ──────────
# SMTP for the reohobenergy.com mailbox (host is on Namecheap / jellyfish.systems).
SMTP_HOST=mail.reohobenergy.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@reohobenergy.com
SMTP_PASS=
# Sender shown on outgoing emails (must be allowed by the SMTP account)
MAIL_FROM="Reohob website <info@reohobenergy.com>"
# Where enquiries go (defaults to installation@reohobenergy.com)
MAIL_TO=installation@reohobenergy.com
# Optional separate inboxes
MAIL_TO_PARTNERSHIPS=
MAIL_TO_TRAINING=
# Local testing without SMTP: log emails to the console instead of sending
MAIL_DRY_RUN=false

# ── Paystack (training payments) ─────────────────────────────
# Secret key: server only, never exposed to the browser.
# Use sk_test_… while testing, sk_live_… in production.
PAYSTACK_SECRET_KEY=
# Webhook URL to set in the Paystack dashboard:
#   https://reohobenergy.com/api/paystack/webhook

# ── Analytics (optional; leave empty for none) ───────────────
# Plausible: cookieless, no consent banner needed.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4: uses cookies, so a consent notice appears and GA
# loads only after the visitor agrees.
NEXT_PUBLIC_GA_ID=

# ── Chatbot (optional) ───────────────────────────────────────
# Embed URL of a working chatbot. Empty = no chat widget at all.
NEXT_PUBLIC_CHATBOT_EMBED_URL=
